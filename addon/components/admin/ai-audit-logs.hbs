<div class="fleetbase-ai-logs {{if this.hasSelection 'has-selection'}}">
    <Admin::AiAdmin::FilterBar
        @filters={{this.filters}}
        @metadata={{this.metadata}}
        @primary={{this.primaryFilters}}
        @secondary={{this.secondaryFilters}}
        @companySource={{this.sources.companies}}
        @userSource={{this.sources.users}}
        @searchPlaceholder="Search conversations, prompts, models..."
        @onChange={{this.filtersChanged}}
    >
        <:actions>
            <DropdownButton @icon="download" @text="Export" @size="xs" @renderInPlace={{true}} @contentClass="dropdown-menu dropdown-menu-right" as |dd|>
                <div class="next-dd-menu mt-1 mx-0">
                    <div class="next-dd-menu-heading">Conversations matching the filters</div>
                    <button type="button" class="next-dd-item w-full" {{on "click" (fn this.export "jsonl" null dd)}}>JSON Lines</button>
                    <button type="button" class="next-dd-item w-full" {{on "click" (fn this.export "csv" null dd)}}>CSV</button>
                </div>
            </DropdownButton>
        </:actions>
    </Admin::AiAdmin::FilterBar>

    <div class="fleetbase-ai-logs-split">
        <Admin::AiLogs::SessionList
            @sessions={{this.sessions}}
            @selectedId={{this.selectedId}}
            @isLoading={{this.loadSessions.isRunning}}
            @isLoadingMore={{this.loadSessions.isRunning}}
            @isFiltered={{this.isFiltered}}
            @hasMore={{this.hasMore}}
            @onSelect={{this.selectSession}}
            @onLoadMore={{this.loadMore}}
        />
        <Admin::AiLogs::SessionPane @session={{this.selectedSession}} @isLoading={{this.loadSession.isRunning}} @onExport={{this.export}} @onClose={{this.closeSession}} />
    </div>
</div>
