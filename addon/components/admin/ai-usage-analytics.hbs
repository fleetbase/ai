<div class="fleetbase-ai-usage">
    <Admin::AiAdmin::FilterBar
        @filters={{this.filters}}
        @metadata={{this.metadata}}
        @primary={{this.toolbarFilters}}
        @secondary={{this.moreFilters}}
        @companySource={{this.sources.companies}}
        @userSource={{this.sources.users}}
        @onChange={{this.filtersChanged}}
    >
        <:before>
            <div class="fleetbase-ai-admin-toolbar-group" role="group" aria-label="Period">
                {{#each this.presets as |preset|}}
                    <Button
                        @type={{if (eq preset.key this.activePreset) "primary" "default"}}
                        @text={{preset.label}}
                        aria-pressed={{if (eq preset.key this.activePreset) "true" "false"}}
                        @onClick={{fn this.selectPreset preset}}
                    />
                {{/each}}
            </div>
        </:before>
    </Admin::AiAdmin::FilterBar>

    <div class="fleetbase-ai-usage-content {{if this.loadUsage.isRunning 'is-loading'}}">
        <Admin::AiUsage::KpiStrip @summary={{this.summary}} />
        <Admin::AiUsage::TrendChart @days={{this.usage.by_day}} @isLoading={{this.loadUsage.isRunning}} />
        <div class="fleetbase-ai-usage-breakdowns">
            <Admin::AiUsage::Breakdown @title="Who" @tabs={{this.whoTabs}} @totalTokens={{this.summary.total_tokens}} @onDrill={{this.drill}} />
            <Admin::AiUsage::Breakdown @title="What" @tabs={{this.whatTabs}} @totalTokens={{this.summary.total_tokens}} @onDrill={{this.drill}} />
        </div>
    </div>
</div>
